#%PAM-1.0
auth    required        pam_succeed_if.so audit quiet_success user = _bande-greeter
auth    optional        pam_permit.so
account required        pam_succeed_if.so audit quiet_success user = _bande-greeter
account optional        pam_permit.so
session required        pam_succeed_if.so audit quiet_success user = _bande-greeter
session optional        pam_keyinit.so force revoke
session required        pam_systemd.so
session required        pam_env.so readenv=1 envfile=/etc/default/locale
session optional        pam_permit.so
