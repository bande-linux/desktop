#!/bin/sh
set -e
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -z "$DPKG_ROOT" ] ; then
		for unit in bande-backup-alerts.service bande-backup-alerts.path ; do
			if deb-systemd-helper --quiet --user was-enabled "$unit" ; then
				deb-systemd-helper --user enable "$unit" >/dev/null || true
			else
				deb-systemd-helper --user update-state "$unit" >/dev/null || true
			fi
		done
	fi
fi
if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
	systemctl --system daemon-reload >/dev/null || true
	if [ -e /var/lib/bande-backup/state.json ]; then
		systemctl try-restart bande-backup.service >/dev/null || true
	fi
fi
