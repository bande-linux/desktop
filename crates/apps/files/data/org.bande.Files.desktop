[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse your folders and files
Icon=org.bande.Files
Exec=bande-files %U
MimeType=inode/directory;
Categories=System;FileTools;FileManager;
Keywords=folder;finder;browse;directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=bande-files
