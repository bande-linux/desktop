msgid "Power"
msgstr "Ström"

msgid "Keep running with the lid closed while on power"
msgstr "Fortsätt köra med stängt lock när datorn är ansluten till ström"

msgid "Low Battery"
msgstr "Lågt batteri"

msgid "{percentage}% of the battery remains. Connect to power soon."
msgstr "{percentage} % av batteriet återstår. Anslut till ström snart."

msgid "Battery Critically Low"
msgstr "Kritiskt lågt batteri"

msgid "{percentage}% of the battery remains. Connect to power now, or the computer will shut down and unsaved work will be lost."
msgstr "{percentage} % av batteriet återstår. Anslut till ström nu, annars stängs datorn av och osparat arbete går förlorat."

msgid "{percentage}% of the battery remains. Connect to power now, or the computer will hibernate."
msgstr "{percentage} % av batteriet återstår. Anslut till ström nu, annars försätts datorn i viloläge på disk."

msgid "{percentage}% of the battery remains. Connect to power now, or the computer will sleep."
msgstr "{percentage} % av batteriet återstår. Anslut till ström nu, annars försätts datorn i vila."

msgid "{name} Battery Low"
msgstr "Låg batterinivå i {name}"

msgid "{name} Battery Almost Empty"
msgstr "Batteriet i {name} är nästan tomt"

msgid "{level}% remains. Charge it soon."
msgstr "{level} % återstår. Ladda den snart."

msgid "{level}% remains. Charge it now."
msgstr "{level} % återstår. Ladda den nu."

msgid "Bluetooth"
msgstr "Bluetooth"

msgid "{percentage}% of the battery remains. Connect to power now."
msgstr "{percentage} % av batteriet återstår. Anslut till ström nu."

msgid "Lock the screen before the computer sleeps"
msgstr "Lås skärmen innan datorn försätts i vila"
