[Unit]
Description=Bande Screen Sharing
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Slice=session.slice
Type=dbus
BusName=org.bande.ScreenSharing.Server
ExecStart=/usr/libexec/bande-screen-sharing
Restart=on-failure
NoNewPrivileges=yes

[Install]
WantedBy=bande-session.target
