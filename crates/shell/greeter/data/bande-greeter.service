[Unit]
Description=Bande login window
After=systemd-user-sessions.service plymouth-start.service plymouth-quit.service
After=getty@tty1.service
Conflicts=getty@tty1.service plymouth-quit.service
Wants=bande-greeter-handover.path bande-greeter-splash.path
OnFailure=bande-console-fallback.service
StartLimitBurst=5
StartLimitIntervalSec=30

[Service]
Type=simple
ExecStart=/usr/libexec/bande-login
RuntimeDirectory=bande-login
KillMode=mixed
TimeoutStopSec=30s
KeyringMode=shared
Restart=always
RestartSec=1

[Install]
Alias=display-manager.service
