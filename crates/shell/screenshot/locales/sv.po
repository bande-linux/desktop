msgid "Screen recording is not available"
msgstr "Skärminspelning är inte tillgänglig"

msgid "Install gstreamer1.0-pipewire, gstreamer1.0-plugins-good and gstreamer1.0-plugins-ugly to record the screen."
msgstr "Installera gstreamer1.0-pipewire, gstreamer1.0-plugins-good och gstreamer1.0-plugins-ugly för att spela in skärmen."

msgid "The screen could not be captured. Try again in a moment."
msgstr "Det gick inte att ta en bild av skärmen. Försök igen om en stund."

msgid "The recording could not be saved"
msgstr "Det gick inte att spara inspelningen"

msgid "Something went wrong while recording. Check that there is enough free disk space and try again."
msgstr "Något gick fel under inspelningen. Kontrollera att det finns tillräckligt med ledigt skivutrymme och försök igen."

msgid "The screenshot could not be saved"
msgstr "Det gick inte att spara skärmbilden"

msgid "Bande could not write to {folder}. Choose another place in the options, or check the folder’s permissions."
msgstr "Bande kunde inte skriva till {folder}. Välj en annan plats i alternativen eller kontrollera mappens behörigheter."

msgid "Screenshot {date} at {time}"
msgstr "Skärmbild {date} kl. {time}"

msgid "Screen Recording {date} at {time}"
msgstr "Skärminspelning {date} kl. {time}"

msgid "OK"
msgstr "OK"

msgid "Recording the screen. Click to stop."
msgstr "Skärmen spelas in. Klicka för att sluta."

