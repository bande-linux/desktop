#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
	rm -rf /var/cache/bande-backup
	if [ -z "$DPKG_ROOT" ] && [ -x "/usr/bin/deb-systemd-helper" ] ; then
		deb-systemd-helper --user purge bande-backup-alerts.service >/dev/null || true
		deb-systemd-helper --user purge bande-backup-alerts.path >/dev/null || true
	fi
fi
if [ -d /run/systemd/system ]; then
	systemctl --system daemon-reload >/dev/null || true
fi
