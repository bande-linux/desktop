msgid "Open an audio or video file to play it."
msgstr "Öppna en ljud- eller videofil för att spela upp den."

msgid "This file can't be played"
msgstr "Den här filen kan inte spelas upp"

msgid "Bande has no decoder for its format."
msgstr "Bande saknar avkodare för filens format."

msgid "This file can't be opened"
msgstr "Den här filen kan inte öppnas"

msgid "It may have been moved, or you may not have permission to read it."
msgstr "Den kan ha flyttats, eller så har du inte behörighet att läsa den."

msgid "Playback stopped"
msgstr "Uppspelningen stoppades"

msgid "The player ran into a problem with this file."
msgstr "Spelaren stötte på ett problem med den här filen."

msgid "Playback controls"
msgstr "Uppspelningsreglage"

msgid "Pause"
msgstr "Pausa"

msgid "Play"
msgstr "Spela upp"

msgid "Timeline"
msgstr "Tidslinje"

msgid "Volume"
msgstr "Volym"
