"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Opening “{name}” needs the {package} package, which isn’t installed."
msgstr "För att öppna ”{name}” behövs paketet {package}, som inte är installerat."

msgid "Device Can’t Be Opened"
msgstr "Enheten kan inte öppnas"

msgid "Install {package}"
msgstr "Installera {package}"

msgid "It couldn’t be downloaded. Check your internet connection, then plug the device in again."
msgstr "Det gick inte att hämta. Kontrollera internetanslutningen och anslut sedan enheten igen."

msgid "Install it in Software, then plug the device in again."
msgstr "Installera det i Programvara och anslut sedan enheten igen."

msgid "Disks"
msgstr "Skivor"

msgid "A Disk Is Failing"
msgstr "En skiva håller på att gå sönder"

msgid "“{name}” reports that it is about to fail. Back up its files now and replace the disk."
msgstr "”{name}” rapporterar att den snart slutar fungera. Säkerhetskopiera filerna på den nu och byt ut skivan."

msgid "Untitled"
msgstr "Namnlös"

msgid "Eject “{label}” before disconnecting it, or files on it may be damaged."
msgstr "Mata ut ”{label}” innan du kopplar från den, annars kan filer på den skadas."

msgid "Disk Not Ejected Properly"
msgstr "Skivan matades inte ut på rätt sätt"

msgid "Server Connection Interrupted"
msgstr "Serveranslutningen avbröts"

msgid "“{name}” isn’t responding. Files on it can’t be reached until it’s back."
msgstr "”{name}” svarar inte. Filer på den går inte att komma åt förrän den är tillbaka."

msgid "Disconnect"
msgstr "Koppla från"

msgid "Server Disconnected"
msgstr "Servern är frånkopplad"

msgid "“{name}” stopped responding. It will reconnect by itself when it’s back."
msgstr "”{name}” slutade svara. Den ansluter igen av sig själv när den är tillbaka."

msgid "Server password for {server}"
msgstr "Serverlösenord för {server}"

msgid "The connection to “{name}” ended."
msgstr "Anslutningen till ”{name}” avslutades."

msgid "{package} Wasn’t Installed"
msgstr "{package} installerades inte"

msgid "Unlock Your Device"
msgstr "Lås upp enheten"

msgid "Unlock “{name}”, choose File transfer on it if it asks, then plug it in again."
msgstr "Lås upp ”{name}”, välj Filöverföring på den om den frågar och anslut den sedan igen."

msgid "Open Disks"
msgstr "Öppna Skivor"

msgid "“{label}” wasn’t unlocked"
msgstr "”{label}” låstes inte upp"

msgid "Open Disks to unlock it."
msgstr "Öppna Skivor för att låsa upp den."

msgid "“{label}” is locked"
msgstr "”{label}” är låst"

msgid "Unlock it to open the files on it."
msgstr "Lås upp den för att öppna filerna på den."

msgid "Unlock…"
msgstr "Lås upp…"

msgid "“{label}” couldn’t be opened"
msgstr "Det gick inte att öppna ”{label}”"

msgid "It may not have been shut down fully in Windows. Open it read-only, or start Windows, shut it down fully and connect the disk again."
msgstr "Den kanske inte stängdes av helt i Windows. Öppna den skrivskyddad, eller starta Windows, stäng av helt och anslut skivan igen."

msgid "Open it read-only to get to the files on it, or open Disks to check it."
msgstr "Öppna den skrivskyddad för att komma åt filerna på den, eller öppna Skivor för att kontrollera den."

msgid "Open Disks to check it."
msgstr "Öppna Skivor för att kontrollera den."

msgid "Open Read-Only"
msgstr "Öppna skrivskyddad"

msgid "This computer can’t read the format of this disk."
msgstr "Den här datorn kan inte läsa skivans format."

msgid "Manage Storage…"
msgstr "Hantera lagring…"

msgid "Storage"
msgstr "Lagring"

msgid "Your disk is almost full"
msgstr "Skivan är nästan full"

msgid "Only {free} is left. Make room by removing files you no longer need."
msgstr "Bara {free} är kvar. Frigör utrymme genom att ta bort filer du inte längre behöver."

msgid "Allow Once"
msgstr "Tillåt en gång"

msgid "Always Allow"
msgstr "Tillåt alltid"

msgid "Thunderbolt"
msgstr "Thunderbolt"

msgid "Allow “{name}”?"
msgstr "Tillåta ”{name}”?"

msgid "A Thunderbolt device gets direct access to this computer. Allow it only if you know where it came from."
msgstr "En Thunderbolt-enhet får direkt åtkomst till datorn. Tillåt den bara om du vet var den kommer ifrån."

msgid "“{name}” wasn’t allowed"
msgstr "”{name}” tilläts inte"

msgid "Disconnect it and connect it again to try again."
msgstr "Koppla från den och anslut den igen för att försöka igen."

msgid "“{label}” is encrypted"
msgstr "”{label}” är krypterad"

msgid "Enter its passphrase to open it."
msgstr "Ange lösenfrasen för att öppna den."

msgid "Unlock"
msgstr "Lås upp"
