[Unit]
Description=Bande backups
After=local-fs.target dbus.service

[Service]
Type=dbus
BusName=org.bande.Backup
ExecStart=/usr/libexec/bande-backupd
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
KillSignal=SIGINT
TimeoutStopSec=45
MemoryHigh=2G
Restart=on-failure
ExecStopPost=-/usr/bin/umount -lc /run/bande-backup-browse
ExecStopPost=-/usr/bin/umount -R -lc /run/bande-backup-local
ExecStopPost=-/usr/bin/umount -lc /run/bande-backup/disk
