#!/bin/sh

if [ "${JOURNAL_STREAM:-}" != "$(stat -L -c %d:%i /proc/self/fd/2)" ]; then
    exec systemd-cat --identifier=bande-session "$0" "$@"
fi

failure_note="/var/lib/bande-greeter/users/$(id -u)/failed"
note_failure() {
    [ -d "${failure_note%/*}" ] || return 0
    if ! (umask 027 && printf '%s\n' "$1" > "$failure_note"); then
        echo "bande-session: cannot tell the login window why the session ended" >&2
    fi
}

if systemctl --user --quiet is-active bande-compositor.service; then
    echo "bande-session: a Bande session is already running" >&2
    note_failure already-running
    exit 1
fi
if [ -e "$failure_note" ] && ! rm -f "$failure_note"; then
    echo "bande-session: cannot remove $failure_note" >&2
fi

export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-xdgdesktopportal}"
export GTK_USE_PORTAL="${GTK_USE_PORTAL:-1}"

locale_variables="LANG LANGUAGE LC_ALL LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY LC_MESSAGES LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE LC_MEASUREMENT LC_IDENTIFICATION"
unset $locale_variables
for system_locale in /etc/locale.conf /etc/default/locale; do
    if [ -r "$system_locale" ]; then
        set -a
        . "$system_locale"
        set +a
        break
    fi
done
user_locale="${XDG_CONFIG_HOME:-$HOME/.config}/locale.conf"
if [ -r "$user_locale" ]; then
    set -a
    . "$user_locale"
    set +a
fi

proxy_variables="http_proxy HTTP_PROXY https_proxy HTTPS_PROXY no_proxy NO_PROXY"
proxy_settings="${XDG_CONFIG_HOME:-$HOME/.config}/bande/proxy"
session_proxy=
if [ -r "$proxy_settings" ]; then
    while IFS= read -r assignment; do
        case "$assignment" in
        http_proxy=* | HTTP_PROXY=* | https_proxy=* | HTTPS_PROXY=* | no_proxy=* | NO_PROXY=*)
            export "$assignment"
            session_proxy="$session_proxy ${assignment%%=*}"
            ;;
        esac
    done < "$proxy_settings"
fi

systemctl --user reset-failed
controls="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/user.control"
limits="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bande-limits"
limit() {
    limited=$1
    shift
    wanted=
    records=
    for assignment; do
        record=${assignment%%=*}
        case $record in
        TasksMax) record=TasksMaxScale ;;
        ManagedOOMMemoryPressureDurationSec) record=ManagedOOMMemoryPressureDurationUSec ;;
        esac
        record="$limited.d/50-$record.conf"
        if [ ! -e "$controls/$record" ]; then
            wanted="$wanted $assignment"
            records="$records $record"
        fi
    done
    [ -n "$wanted" ] || return 0
    systemctl --user set-property --runtime "$limited" $wanted || return 0
    mkdir -p "$limits/$limited.d"
    for record in $records; do
        cp "$controls/$record" "$limits/$record"
    done
}
set_limits() {
    limit app.slice ManagedOOMMemoryPressure=kill ManagedOOMMemoryPressureLimit=40% \
        ManagedOOMMemoryPressureDurationSec=10s TasksMax=25% CPUWeight=50
    for unit in dbus.service pipewire.service pipewire-pulse.service wireplumber.service xdg-desktop-portal.service; do
        limit "$unit" ManagedOOMPreference=avoid
    done
    memory=$(sed -n 's/^MemTotal: *\([0-9]*\) kB$/\1/p' /proc/meminfo)
    swap=$(sed -n 's/^SwapTotal: *\([0-9]*\) kB$/\1/p' /proc/meminfo)
    [ -n "$memory" ] || return 0
    limit session.slice MemoryMin="$((memory / 10 < 524288 ? memory / 10 : 524288))K"
    reserve=$((memory / 5 < 3145728 ? memory / 5 : 3145728))
    reserve=$((reserve < ${swap:-0} / 2 ? reserve : ${swap:-0} / 2))
    [ "$reserve" -eq 0 ] || limit app.slice MemoryHigh="$((memory - reserve))K" MemoryMax="$((memory - reserve * 7 / 8))K"
}
forget_limits() {
    [ -d "$limits" ] || return 0
    (
        cd "$limits" || exit
        for record in *.d/*.conf; do
            if cmp -s "$record" "$controls/$record"; then
                rm -f "$controls/$record"
                rmdir "$controls/${record%/*}" 2>/dev/null
            fi
        done
    )
    rm -rf "$limits"
    systemctl --user daemon-reload
}
forget_limits
set_limits
systemctl --user unset-environment $locale_variables BANDE_LOGIN_ACCESSIBILITY
systemctl --user import-environment ELECTRON_OZONE_PLATFORM_HINT QT_QPA_PLATFORMTHEME GTK_USE_PORTAL PATH $locale_variables XDG_SEAT XDG_SESSION_ID XDG_SESSION_CLASS \
    XDG_SESSION_DESKTOP XDG_VTNR XDG_DATA_DIRS XDG_CONFIG_DIRS BANDE_LOGIN_ACCESSIBILITY $session_proxy 2>/dev/null
dbus-update-activation-environment $locale_variables $session_proxy 2>/dev/null
ending=
trap 'ending=1; systemctl --user --no-block stop bande-compositor.service' TERM HUP
started=$(date +%s)
systemctl --user --wait start bande-compositor.service &
waiter=$!
wait "$waiter"
status=$?
while kill -0 "$waiter" 2>/dev/null; do
    wait "$waiter"
    status=$?
done
trap - TERM HUP
forget_limits
if [ -z "$ending" ] && [ "$status" -ne 0 ]; then
    note_failure failed
elif [ -z "$ending" ] && [ $(($(date +%s) - started)) -lt 5 ]; then
    note_failure quick
fi
systemctl --user stop bande-compositor.service
systemctl --user unset-environment ELECTRON_OZONE_PLATFORM_HINT QT_QPA_PLATFORMTHEME GTK_USE_PORTAL WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_MENU_PREFIX BANDE_LOGIN_ACCESSIBILITY
if [ -n "$session_proxy" ] || [ -e "$proxy_settings" ]; then
    systemctl --user unset-environment $proxy_variables
fi
exit "$status"
