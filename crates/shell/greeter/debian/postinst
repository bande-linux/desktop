#!/bin/sh
set -e
DISPLAY_MANAGER=/etc/systemd/system/display-manager.service
GREETD=/usr/lib/systemd/system/greetd.service
DEFAULT_DISPLAY_MANAGER=/etc/X11/default-display-manager
PICTURES=/var/lib/unbound-greeter/pictures
if [ "$1" = "configure" ] && [ -z "$DPKG_ROOT" ]; then
	if [ -z "$2" ] && [ ! -e "$DISPLAY_MANAGER" ] && [ ! -L "$DISPLAY_MANAGER" ]; then
		ln -s "$GREETD" "$DISPLAY_MANAGER"
	fi
	if [ "$(readlink "$DISPLAY_MANAGER" || true)" = "$GREETD" ] && [ ! -e "$DEFAULT_DISPLAY_MANAGER" ]; then
		mkdir -p /etc/X11
		echo /usr/sbin/greetd > "$DEFAULT_DISPLAY_MANAGER"
	fi
	mkdir -p "$PICTURES"
	chown root:_greetd "$PICTURES"
	chmod 3733 "$PICTURES"
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null 2>&1 || true
	fi
fi
