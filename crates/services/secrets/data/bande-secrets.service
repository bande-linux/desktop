[Unit]
Description=Bande keychain
Requires=bande-secrets.socket
After=bande-secrets.socket

[Service]
Slice=session.slice
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/libexec/bande-secrets
Restart=on-failure
LimitCORE=0
NoNewPrivileges=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

[Install]
Also=bande-secrets.socket
WantedBy=bande-session.target
