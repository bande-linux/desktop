# Post notifications from a terminal, watch the banners, then open the Notification Center and Control Center.
key super+space
wait 600ms
type "terminal"
wait 500ms
key enter
wait-for-window "org.bande.Terminal"
wait 1s
note "Post a notification"
type "gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications --method org.freedesktop.Notifications.Notify Terminal 0 utilities-terminal 'Build finished' 'All 412 tests passed in 38 seconds' [] {} 0\n"
wait 1500ms
shot "banner"
note "A second one from the same app stacks"
type "gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications --method org.freedesktop.Notifications.Notify Terminal 0 utilities-terminal 'Deploy done' 'bande.example is live' [] {} 0\n"
wait 1500ms
shot "stacked banner"
note "Hover the banner shows the close button"
move 2600 140
wait 1s
shot "banner hovered"
move 1500 900
wait 7s
shot "banners gone"
note "The clock opens the Notification Center"
click 2800 22
wait 1200ms
shot "notification center"
key escape
wait 800ms
shot "notification center closed"
note "Control Center from its menu bar item"
click 2635 22
wait 1200ms
shot "control center"
key escape
wait 800ms
