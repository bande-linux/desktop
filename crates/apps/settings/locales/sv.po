msgid "Picture, drag to move and scroll to zoom"
msgstr "Bild, dra för att flytta och scrolla för att zooma"

msgid "Zoom"
msgstr "Zoom"

msgid "Save"
msgstr "Spara"

msgid "Drag the picture to choose what shows in the circle."
msgstr "Dra bilden för att välja vad som visas i cirkeln."

msgid "Delete User…"
msgstr "Radera användare …"

msgid "Delete this user"
msgstr "Radera den här användaren"

msgid "Keep Home Folder"
msgstr "Behåll hemmappen"

msgid "Delete Home Folder"
msgstr "Radera hemmappen"

msgid "Keep the home folder to keep their files in /home/{login}, or delete it and everything in it."
msgstr "Behåll hemmappen för att behålla användarens filer i /home/{login}, eller radera den och allt i den."

msgid "Type the person's full name."
msgstr "Skriv personens fullständiga namn."

msgid "Use lowercase letters, digits, - and _ for the account name, starting with a letter."
msgstr "Använd små bokstäver, siffror, - och _ i kontonamnet, och börja med en bokstav."

msgid "That account name is already used. Choose another one."
msgstr "Kontonamnet används redan. Välj ett annat."

msgid "Type a new password."
msgstr "Skriv ett nytt lösenord."

msgid "The passwords don't match. Type the password again."
msgstr "Lösenorden stämmer inte överens. Skriv lösenordet igen."

msgid "Changing the password…"
msgstr "Ändrar lösenordet …"

msgid "Press Return after each field to change the password, or Escape to cancel"
msgstr "Tryck på Retur efter varje fält för att ändra lösenordet, eller Escape för att avbryta"

msgid "Type your current password first."
msgstr "Skriv ditt nuvarande lösenord först."

msgid "The new passwords don't match. Type the new password again."
msgstr "De nya lösenorden stämmer inte överens. Skriv det nya lösenordet igen."

msgid "Your password was changed. Use it the next time you log in or unlock."
msgstr "Lösenordet har ändrats. Använd det nästa gång du loggar in eller låser upp."

msgid "The current password is not correct."
msgstr "Det nuvarande lösenordet är fel."

msgid "That password can't be used: {reason}"
msgstr "Lösenordet kan inte användas: {reason}"

msgid "That password is too weak. Choose a longer one."
msgstr "Lösenordet är för svagt. Välj ett längre."

msgid "Couldn't change the password."
msgstr "Det gick inte att ändra lösenordet."

msgid "Search"
msgstr "Sök"

msgid "The password is not correct. Try again."
msgstr "Lösenordet är fel. Försök igen."

msgid "Could not join the network: {reason}."
msgstr "Det gick inte att ansluta till nätverket: {reason}."

msgid "Enter DNS servers as IPv4 addresses, such as 1.1.1.1, 9.9.9.9."
msgstr "Ange DNS-servrar som IPv4-adresser, till exempel 1.1.1.1, 9.9.9.9."

msgid "Type an address such as 192.168.1.20/24, and the router and DNS servers as addresses such as 192.168.1.1."
msgstr "Skriv en adress som 192.168.1.20/24, och router och DNS-servrar som adresser som 192.168.1.1."

msgid "Enter a time such as 22:00."
msgstr "Ange en tid som 22:00."

msgid "Type the date and time as year-month-day hours:minutes, such as 2026-10-30 14:05."
msgstr "Skriv datum och tid som år-månad-dag timmar:minuter, till exempel 2026-10-30 14:05."

msgid "None"
msgstr "Ingen"

msgid "WPA2 Personal"
msgstr "WPA2 Personal"

msgid "WPA3 Personal"
msgstr "WPA3 Personal"

msgid "Fixed"
msgstr "Fast"

msgid "Rotating"
msgstr "Roterande"

msgid "Connected · sign in to use the internet"
msgstr "Ansluten · logga in för att använda internet"

msgid "Joining…"
msgstr "Ansluter …"

msgid "Not in range"
msgstr "Utom räckhåll"

msgid "Saved · Auto-Join off"
msgstr "Sparat · Anslut automatiskt av"

msgid "Saved"
msgstr "Sparat"

msgid "Details…"
msgstr "Detaljer …"

msgid "Networks you join are remembered here"
msgstr "Nätverk du ansluter till sparas här"

msgid "Sign In…"
msgstr "Logga in …"

msgid "Press Return to join or Escape to cancel"
msgstr "Tryck på Retur för att ansluta eller Escape för att avbryta"

msgid "Password for “{network}”"
msgstr "Lösenord för ”{network}”"

msgid "Looking for networks…"
msgstr "Söker efter nätverk …"

msgid "Other…"
msgstr "Annat …"

msgid "Join a network that does not show its name"
msgstr "Anslut till ett nätverk som inte visar sitt namn"

msgid "Network name"
msgstr "Nätverksnamn"

msgid "Security"
msgstr "Säkerhet"

msgid "Press Return in the password field to join, or Escape to cancel"
msgstr "Tryck på Retur i lösenordsfältet för att ansluta, eller Escape för att avbryta"

msgid "Join"
msgstr "Anslut"

msgid "Auto-Join"
msgstr "Anslut automatiskt"

msgid "Join this network on its own when it is in range"
msgstr "Anslut till nätverket av sig självt när det är inom räckhåll"

msgid "Low Data Mode"
msgstr "Låg datamängd"

msgid "Marks the network as metered, so apps hold back large downloads"
msgstr "Markerar nätverket som med datatak, så att appar väntar med stora hämtningar"

msgid "Private Wi-Fi address"
msgstr "Privat Wi-Fi-adress"

msgid "A private address makes this computer harder to track across networks"
msgstr "En privat adress gör det svårare att spåra datorn mellan nätverk"

msgid "Wi-Fi address"
msgstr "Wi-Fi-adress"

msgid "Connection"
msgstr "Anslutning"

msgid "TCP/IP"
msgstr "TCP/IP"

msgid "Its password is removed and Bande no longer joins it on its own."
msgstr "Lösenordet tas bort och Bande ansluter inte till det av sig självt längre."

msgid "Forget This Network"
msgstr "Glöm det här nätverket"

msgid "Type the name of the network to join."
msgstr "Skriv namnet på nätverket du vill ansluta till."
