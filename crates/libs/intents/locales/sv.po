msgstr ""
"Language: sv\n"
"Language-Team: Swedish\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "A program in a sandbox cannot do this"
msgstr "Ett program i en sandlåda kan inte göra det här"

msgid "This program cannot act for an agent"
msgstr "Det här programmet kan inte handla åt en agent"

msgid "There is nothing to undo"
msgstr "Det finns inget att ångra"

msgid "{intent} has no “{parameter}”"
msgstr "{intent} har ingen ”{parameter}”"

msgid "This has to be allowed first, and there is nothing to ask with yet"
msgstr "Det här måste tillåtas först, och det finns inget att fråga med än"

msgid "This was started by another program"
msgstr "Det här startades av ett annat program"

msgid "{domain} is not permitted"
msgstr "{domain} är inte tillåtet"

msgid "Nothing can do “{intent}”"
msgstr "Inget kan göra ”{intent}”"

msgid "This is too old or already done"
msgstr "Det här är för gammalt eller redan gjort"

msgid "This was interrupted. It may have been done."
msgstr "Det här avbröts. Det kan ha blivit gjort."

msgid "Undo cannot be kept now, so this is not done"
msgstr "Ångra kan inte sparas just nu, så det här görs inte"

msgid "Undo"
msgstr "Ångra"

msgid "This cannot be undone: there is no room to keep it"
msgstr "Det här kan inte ångras: det finns inget utrymme att spara det"

msgid "Too much is waiting. Try again in 10 minutes."
msgstr "För mycket väntar. Försök igen om 10 minuter."

msgid "This was changed again since: {change}"
msgstr "Det här har ändrats igen sedan dess: {change}"

msgid "This was prepared by another program"
msgstr "Det här förbereddes av ett annat program"

msgid "The caller is unknown"
msgstr "Anroparen är okänd"

msgid "s, sec, secs, second, seconds"
msgstr "s, sek, sekund, sekunder"

msgid "m, min, mins, minute, minutes"
msgstr "m, min, minut, minuter"

msgid "h, hr, hrs, hour, hours"
msgstr "h, tim, timme, timmar"

msgid "Undo cannot be kept: {error}"
msgstr "Ångra kan inte sparas: {error}"

msgid "Another program is using “{domain}”. Try again."
msgstr "Ett annat program använder ”{domain}”. Försök igen."

msgid "“{parameter}” takes: {accepts}"
msgstr "”{parameter}” tar: {accepts}"

msgid "The program ended while it worked. The change may be there in part or whole."
msgstr "Programmet avslutades medan det arbetade. Ändringen kan vara gjord helt eller delvis."
