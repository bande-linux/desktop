msgid "Screen Sharing"
msgstr "Skärmdelning"

msgid "Let someone see and control this screen?"
msgstr "Låta någon se och styra den här skärmen?"

msgid "A viewer at {address} knows the Screen Sharing password."
msgstr "En visare på {address} kan lösenordet för skärmdelning."

msgid "Deny"
msgstr "Neka"

msgid "Allow"
msgstr "Tillåt"

msgid "Someone is viewing this screen"
msgstr "Någon tittar på den här skärmen"

msgid "A viewer at {address} can see and control it. Click the screen symbol in the Taskbar to stop."
msgstr "En visare på {address} kan se och styra den. Klicka på skärmsymbolen i aktivitetsfältet för att sluta."
