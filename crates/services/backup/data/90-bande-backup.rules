ACTION=="add", SUBSYSTEM=="block", ENV{ID_FS_USAGE}=="filesystem", ENV{DEVTYPE}=="partition|disk", TEST=="/var/lib/bande-backup/state.json", RUN+="/usr/bin/systemctl --no-block start bande-backup.service"
ACTION=="change", SUBSYSTEM=="power_supply", ATTR{type}=="Mains|USB", ATTR{online}=="1", TEST=="/var/lib/bande-backup/state.json", RUN+="/usr/bin/systemctl --no-block start bande-backup.service"
