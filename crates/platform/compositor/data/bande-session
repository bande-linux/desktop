#!/bin/sh

if [ "${JOURNAL_STREAM:-}" != "$(stat -L -c %d:%i /proc/self/fd/2)" ]; then
    exec systemd-cat --identifier=bande-session "$0" "$@"
fi

if systemctl --user --quiet is-active bande-compositor.service; then
    echo "bande-session: an Bande session is already running" >&2
    exit 1
fi

export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-xdgdesktopportal}"
export GTK_USE_PORTAL="${GTK_USE_PORTAL:-1}"

systemctl --user reset-failed
systemctl --user import-environment ELECTRON_OZONE_PLATFORM_HINT QT_QPA_PLATFORMTHEME GTK_USE_PORTAL PATH LANG LANGUAGE XDG_SEAT XDG_SESSION_ID XDG_SESSION_CLASS \
    XDG_SESSION_DESKTOP XDG_VTNR XDG_DATA_DIRS XDG_CONFIG_DIRS 2>/dev/null
status=0
systemctl --user --wait start bande-compositor.service || status=$?
systemctl --user unset-environment ELECTRON_OZONE_PLATFORM_HINT QT_QPA_PLATFORMTHEME GTK_USE_PORTAL WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exit "$status"
