msgid "Power"
msgstr "Ström"

msgid "Keep running with the lid closed while on power"
msgstr "Fortsätt köra med stängt lock när datorn är ansluten till ström"

msgid "Low Battery"
msgstr "Lågt batteri"

msgid "{percentage}% of the battery remains. Connect to power soon."
msgstr "{percentage} % av batteriet återstår. Anslut till ström snart."

msgid "Battery Critically Low"
msgstr "Kritiskt lågt batteri"

msgid "{percentage}% of the battery remains. Connect to power now, or the computer will sleep."
msgstr "{percentage} % av batteriet återstår. Anslut till ström nu, annars försätts datorn i vila."

msgid "Lock the screen before the computer sleeps"
msgstr "Lås skärmen innan datorn försätts i vila"
