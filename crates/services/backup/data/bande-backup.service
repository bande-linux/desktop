[Unit]
Description=Bande backups
After=local-fs.target dbus.service

[Service]
Type=dbus
BusName=org.bande.Backup
ExecStart=/usr/libexec/bande-backupd
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
KillSignal=SIGINT
TimeoutStopSec=45
ExecStopPost=-/usr/bin/umount -l /run/bande-backup-browse
ExecStopPost=-/usr/bin/umount -l /run/bande-backup/disk
