msgstr "Anna Lind"

msgid "name@example.org"
msgstr "namn@example.org"

msgid "Same as the email address"
msgstr "Samma som e-postadressen"

msgid "Required"
msgstr "Obligatoriskt"

msgid "imap.example.org"
msgstr "imap.example.org"

msgid "smtp.example.org"
msgstr "smtp.example.org"

msgid "Default"
msgstr "Standard"

msgid "Enter Server Settings Manually"
msgstr "Ange serverinställningar manuellt"

msgid "Back"
msgstr "Tillbaka"

msgid "Server Settings…"
msgstr "Serverinställningar…"

msgid "Continue"
msgstr "Fortsätt"

msgid "Sign In"
msgstr "Logga in"

msgid "Security"
msgstr "Säkerhet"

msgid "Also use this account for Notes"
msgstr "Använd även kontot för Anteckningar"

msgid "Account Type"
msgstr "Kontotyp"

msgid "IMAP and SMTP"
msgstr "IMAP och SMTP"

msgid "Cancel"
msgstr "Avbryt"

msgid "Checking the account…"
msgstr "Kontrollerar kontot…"

msgid "Add a Mail Account"
msgstr "Lägg till ett e-postkonto"

msgid "Choose the type of account. Mail reads and sends mail with IMAP and SMTP, the open standards mail providers offer."
msgstr "Välj typ av konto. E-post läser och skickar e-post med IMAP och SMTP, de öppna standarder som e-postleverantörer erbjuder."

msgid "Enter your name, email address and password. Mail looks up the servers of your address’s domain and shows them to you before it signs in."
msgstr "Ange ditt namn, din e-postadress och ditt lösenord. E-post slår upp servrarna för adressens domän och visar dem för dig innan den loggar in."

msgid "Mail Server Settings"
msgstr "Inställningar för e-postservrar"

msgid "Check the settings your mail provider gives for IMAP and SMTP, then sign in."
msgstr "Kontrollera de inställningar för IMAP och SMTP som din e-postleverantör anger och logga sedan in."

msgid "Enter Your Password"
msgstr "Ange ditt lösenord"

msgid "The server did not accept the password for {email}."
msgstr "Servern godtog inte lösenordet för {email}."

msgid "“{address}” is not a mail address"
msgstr "”{address}” är ingen e-postadress"

msgid "the server offers no sign-in method Mail knows: {methods}"
msgstr "servern erbjuder inget inloggningssätt som E-post kan: {methods}"

msgid "the message has no recipients"
msgstr "meddelandet har inga mottagare"
