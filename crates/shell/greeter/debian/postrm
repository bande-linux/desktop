#!/bin/sh
set -e
DEFAULT_DISPLAY_MANAGER=/etc/X11/default-display-manager
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
	systemctl --system daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = "purge" ] && [ -z "$DPKG_ROOT" ] && [ "$(cat "$DEFAULT_DISPLAY_MANAGER" 2>/dev/null || true)" = /usr/sbin/greetd ]; then
	rm -f "$DEFAULT_DISPLAY_MANAGER"
fi
if [ "$1" = "purge" ]; then
	rm -rf /var/lib/unbound-greeter
fi
