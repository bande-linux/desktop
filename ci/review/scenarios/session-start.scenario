# The desktop right after login, then the menus of the desktop, the taskbar and the Bande logo.
note "A fresh session: wallpaper and the dark taskbar on the left"
wait 2s
shot "desktop after login"
note "Right-click the empty desktop"
click right 1700 1000
wait 1s
shot "desktop menu"
key escape
wait 500ms
note "Right-click the first taskbar icon"
click right 75 735
wait 1s
shot "taskbar menu"
key escape
wait 500ms
note "Right-click the Bande logo at the top of the taskbar: the Bande menu"
click right 64 52
wait 1s
shot "system menu"
key escape
wait 500ms
note "Super+N opens the Notification Center"
key super+n
wait 1200ms
shot "notification center"
key escape
wait 800ms
note "Tapping Super opens Search"
key super
wait 800ms
shot "launcher"
key escape
wait 500ms
shot "back to the desktop"
