#!/usr/bin/make -f

ifeq ($(DEB_VERSION_OVERRIDE),)
$(error DEB_VERSION_OVERRIDE must hold the version from ci/deb/version.sh)
endif

%:
	dh $@

override_dh_gencontrol:
	debian/default-apps.sh >> debian/bande-desktop.substvars
	dh_gencontrol -- -v$(DEB_VERSION_OVERRIDE)

override_dh_install:
	dh_install
	mkdir -p debian/bande-icon-theme/usr/share/icons
	cp -R ../../data/icons/Bande ../../data/icons/Bande-* debian/bande-icon-theme/usr/share/icons/
