# The desktop right after login, then the menus of the desktop, the Dock and the menu bar.
note "A fresh session: wallpaper, menu bar, Dock"
wait 2s
shot "desktop after login"
note "Right-click the empty desktop"
click right 1700 1000
wait 1s
shot "desktop menu"
key escape
wait 500ms
note "Right-click the first Dock icon"
click right 75 735
wait 1s
shot "dock menu"
key escape
wait 500ms
note "The system menu at the far left of the menu bar"
click 45 22
wait 1s
shot "system menu"
key escape
wait 500ms
note "The clock opens the Notification Center"
click 2800 22
wait 1200ms
shot "notification center"
key escape
wait 800ms
note "Super+Space opens the launcher"
key super+space
wait 800ms
shot "launcher"
key escape
wait 500ms
shot "back to the desktop"
