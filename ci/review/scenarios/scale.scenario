# Change the display scale to 1.5 and 1 through config.kdl and look at the shell and apps at each, then restore it.
key super+space
wait 600ms
type "terminal"
wait 500ms
key enter
wait-for-window "org.unbound.Terminal"
wait 1s
type "cp ~/.config/unbound/config.kdl /tmp/config.kdl.review; echo 'output \"Virtual-1\" { scale 1.5; }' >> ~/.config/unbound/config.kdl; clear\n"
wait 3s
shot "scale 1.5 terminal"
key super+space
wait 600ms
type "files"
wait 500ms
key enter
wait-for-window "org.unbound.Files"
wait 2s
shot "scale 1.5 files"
click right 1700 1300
wait 1s
shot "scale 1.5 context menu"
key escape
wait 500ms
key super+space
wait 800ms
type "set"
wait 800ms
shot "scale 1.5 launcher"
key escape
key escape
wait 500ms
click 1500 900
wait 300ms
key super+q
wait 1500ms
type "sed -i 's/scale 1.5/scale 1/' ~/.config/unbound/config.kdl; clear\n"
wait 3s
shot "scale 1"
type "cp /tmp/config.kdl.review ~/.config/unbound/config.kdl\n"
wait 3s
shot "scale restored"
