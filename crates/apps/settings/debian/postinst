#!/bin/sh
set -e
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -z "$DPKG_ROOT" ] ; then
		if deb-systemd-helper --quiet --user was-enabled bande-update-check.timer ; then
			deb-systemd-helper --user enable bande-update-check.timer >/dev/null || true
		else
			deb-systemd-helper --user update-state bande-update-check.timer >/dev/null || true
		fi
	fi
fi
