[Unit]
Description=Unbound speaker thermal protection
Conflicts=speakersafetyd.service
After=speakersafetyd.service

[Service]
Type=simple
ExecStart=/usr/bin/unbound-speaker-guard
DynamicUser=yes
SupplementaryGroups=audio
RuntimeDirectory=unbound-speaker-guard
RuntimeDirectoryPreserve=yes
StateDirectory=unbound-speaker-guard
UMask=0077
Restart=on-failure
RestartSec=1
StartLimitIntervalSec=60
StartLimitBurst=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateNetwork=yes
DevicePolicy=closed
DeviceAllow=char-alsa rw

