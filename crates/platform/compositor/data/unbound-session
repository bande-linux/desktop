#!/bin/sh

if systemctl --user --quiet is-active unbound-compositor.service; then
    echo "unbound-session: an Unbound session is already running" >&2
    exit 1
fi

export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-xdgdesktopportal}"

systemctl --user reset-failed
systemctl --user import-environment ELECTRON_OZONE_PLATFORM_HINT QT_QPA_PLATFORMTHEME PATH LANG LANGUAGE XDG_SEAT XDG_SESSION_ID XDG_SESSION_CLASS \
    XDG_SESSION_DESKTOP XDG_VTNR XDG_DATA_DIRS XDG_CONFIG_DIRS 2>/dev/null
status=0
systemctl --user --wait start unbound-compositor.service || status=$?
systemctl --user unset-environment ELECTRON_OZONE_PLATFORM_HINT QT_QPA_PLATFORMTHEME WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exit "$status"
