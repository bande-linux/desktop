<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Bande</vendor>
  <action id="org.bande.backup.configure">
    <description>Choose the backup disk</description>
    <description xml:lang="sv">Välj säkerhetskopieringsskiva</description>
    <message>Authentication is required to change where this computer is backed up.</message>
    <message xml:lang="sv">Autentisering krävs för att ändra var den här datorn säkerhetskopieras.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.bande.backup.control">
    <description>Start or pause a backup</description>
    <description xml:lang="sv">Starta eller pausa en säkerhetskopiering</description>
    <message>Authentication is required to start or pause a backup.</message>
    <message xml:lang="sv">Autentisering krävs för att starta eller pausa en säkerhetskopiering.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
