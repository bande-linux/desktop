#!/bin/bash
# Next to another display manager, installing the login window offers it and does not impose it,
# leaves greetd's own service and configuration alone, dpkg-reconfigure switches both ways, and
# removing the login window hands the display back.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
default_display_manager() {
    grep -qx "$1" /etc/X11/default-display-manager
    [ "$(basename "$(readlink /etc/systemd/system/display-manager.service)")" = "$(basename "$1").service" ]
    [ "$(echo get shared/default-x-display-manager | debconf-communicate)" = "0 $(basename "$1")" ]
}
choose() {
    echo "$2" | DEBIAN_FRONTEND=teletype script -qec "dpkg-reconfigure $1" /dev/null > /dev/null
}
default_display_manager /usr/sbin/lightdm
[ "$(dpkg-query -W -f '${db:Status-Status}' bande-greeter 2>/dev/null || true)" != installed ]
apt-get install -y -q --no-install-recommends bande-greeter < /dev/null
default_display_manager /usr/sbin/lightdm
echo metaget shared/default-x-display-manager choices | debconf-communicate | grep -qw bande-greeter
test ! -e /usr/lib/systemd/system/greetd.service.d
dpkg --verify greetd
choose bande-greeter bande-greeter
default_display_manager /usr/bin/bande-greeter
choose lightdm lightdm
default_display_manager /usr/sbin/lightdm
choose bande-greeter bande-greeter
default_display_manager /usr/bin/bande-greeter
apt-get remove -y -q bande-greeter < /dev/null
default_display_manager /usr/sbin/lightdm
if echo metaget shared/default-x-display-manager choices | debconf-communicate | grep -qw bande-greeter; then
    echo "bande-greeter is still offered after its removal"
    exit 1
fi
echo "the Bande login window is offered next to LightDM, not imposed"
