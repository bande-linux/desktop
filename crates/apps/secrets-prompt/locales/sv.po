msgid "An app"
msgstr "En app"

msgid "“{app}” wants to use the “{keyring}” keyring."
msgstr "”{app}” vill använda nyckelringen ”{keyring}”."

msgid "Enter the keyring password."
msgstr "Ange nyckelringens lösenord."

msgid "“{app}” wants to use your confidential information stored in “{item}” in your keyring."
msgid_plural "“{app}” wants to use {count} passwords stored in your keyring."
msgstr[0] "”{app}” vill använda din känsliga information som är lagrad i ”{item}” i din nyckelring."
msgstr[1] "”{app}” vill använda {count} lösenord som är lagrade i din nyckelring."

msgid "To allow this, enter the “{keyring}” keyring password."
msgstr "För att tillåta det anger du lösenordet för nyckelringen ”{keyring}”."

msgid "“{app}” wants to create a new keyring, “{keyring}”."
msgstr "”{app}” vill skapa en ny nyckelring, ”{keyring}”."

msgid "Choose a password for the new keyring."
msgstr "Välj ett lösenord för den nya nyckelringen."

msgid "Enter the password again to verify it."
msgstr "Ange lösenordet igen för att verifiera det."

msgid "Your login keyring was not unlocked with your login password."
msgstr "Din inloggningsnyckelring låstes inte upp med ditt inloggningslösenord."

msgid "Enter the keyring’s old password to update it to your login password, or create a new keyring. The old keyring is kept."
msgstr "Ange nyckelringens gamla lösenord för att uppdatera det till ditt inloggningslösenord, eller skapa en ny nyckelring. Den gamla nyckelringen sparas."

msgid "“{app}” wants to show your saved passwords."
msgstr "”{app}” vill visa dina sparade lösenord."

msgid "The network “{network}” requires a password."
msgstr "Nätverket ”{network}” kräver ett lösenord."

msgid "Enter the password to join it."
msgstr "Ange lösenordet för att ansluta till det."

msgid "A passphrase is needed"
msgstr "En lösenfras behövs"

msgid "GnuPG needs your confirmation"
msgstr "GnuPG behöver din bekräftelse"

msgid "Enter the passphrase again to verify it."
msgstr "Ange lösenfrasen igen för att bekräfta den."

msgid "Verify"
msgstr "Verifiera"

msgid "Passphrase"
msgstr "Lösenfras"

msgid "Password"
msgstr "Lösenord"

msgid "Cancel"
msgstr "Avbryt"

msgid "OK"
msgstr "OK"

msgid "No"
msgstr "Nej"

msgid "Always Allow"
msgstr "Tillåt alltid"

msgid "Deny"
msgstr "Neka"

msgid "Allow"
msgstr "Tillåt"

msgid "Create"
msgstr "Skapa"

msgid "Join"
msgstr "Anslut"

msgid "Create New Keyring"
msgstr "Skapa ny nyckelring"

msgid "Not Now"
msgstr "Inte nu"

msgid "Update Password"
msgstr "Uppdatera lösenord"

msgid "Type the password to continue."
msgstr "Skriv lösenordet för att fortsätta."

msgid "The passphrases don’t match. Try again."
msgstr "Lösenfraserna stämmer inte överens. Försök igen."

msgid "The passwords don’t match. Try again."
msgstr "Lösenorden stämmer inte överens. Försök igen."

msgid "The password you entered is incorrect."
msgstr "Lösenordet du angav är fel."
