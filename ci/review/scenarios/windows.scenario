# Place windows with Super+arrows, fill the screen with F11 and spread four fingers to reveal the desktop.
key super
wait 600ms
type "terminal"
wait 500ms
key enter
wait-for-window "org.bande.Terminal"
wait 1s
key super
wait 600ms
type "files"
wait 500ms
key enter
wait-for-window "org.bande.Files"
wait 1500ms
shot "two windows"
note "Super+Left fills the left half"
key super+left
wait 1s
shot "files on the left half"
note "Alt+Tab, then Super+Right"
key alt+tab
wait 800ms
key super+right
wait 1s
shot "side by side"
note "Super+Up keeps the top of its half"
key super+up
wait 1s
shot "terminal in the top right quarter"
key super+down
wait 1s
shot "terminal back on the right half"
note "F11 fills the screen and toggles back"
key f11
wait 1200ms
shot "terminal full screen"
key f11
wait 1200ms
note "Spread four fingers to reveal the desktop"
pinch out 4
wait 1200ms
shot "desktop revealed"
note "Pinch four fingers to bring the windows back"
pinch in 4
wait 1200ms
shot "windows back"
