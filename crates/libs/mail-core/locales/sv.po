msgstr "Inkommande (IMAP):"

msgid "Outgoing (SMTP):"
msgstr "Utgående (SMTP):"

msgid "Port:"
msgstr "Port:"

msgid "Security:"
msgstr "Säkerhet:"

msgid "Description:"
msgstr "Beskrivning:"

msgid "Ann Lee"
msgstr "Anna Lind"

msgid "name@example.org"
msgstr "namn@example.org"

msgid "Same as the email address"
msgstr "Samma som e-postadressen"

msgid "Required"
msgstr "Obligatoriskt"

msgid "imap.example.org"
msgstr "imap.example.org"

msgid "smtp.example.org"
msgstr "smtp.example.org"

msgid "Default"
msgstr "Standard"

msgid "Work, Home…"
msgstr "Arbete, Hem…"

msgid "Set Up Manually…"
msgstr "Ställ in manuellt…"

msgid "Change Settings…"
msgstr "Ändra inställningar…"

msgid "Back"
msgstr "Tillbaka"

msgid "Server Settings…"
msgstr "Serverinställningar…"

msgid "Continue"
msgstr "Fortsätt"

msgid "Sign In"
msgstr "Logga in"

msgid "Done"
msgstr "Klar"

msgid "Add a Mail Account"
msgstr "Lägg till ett e-postkonto"

msgid "Enter your name, email address and password."
msgstr "Ange ditt namn, din e-postadress och ditt lösenord."

msgid "Mail is checking the account. This can take a moment."
msgstr "E-post kontrollerar kontot. Det kan ta en stund."

msgid "Sign In to These Servers?"
msgstr "Logga in på de här servrarna?"

msgid "Mail Server Settings"
msgstr "Inställningar för e-postservrar"

msgid "Enter the settings your mail provider gives for IMAP and SMTP, then sign in."
msgstr "Ange de inställningar för IMAP och SMTP som din e-postleverantör anger och logga sedan in."

msgid "Account Added"
msgstr "Kontot har lagts till"

msgid "{email} is ready. Mail is downloading your mail; you can start reading now."
msgstr "{email} är klart. E-post hämtar din e-post; du kan börja läsa redan nu."

msgid "Enter Your Password"
msgstr "Ange ditt lösenord"

msgid "The server did not accept the password for {email}."
msgstr "Servern godtog inte lösenordet för {email}."

msgid "Mail works with any provider that offers IMAP and SMTP."
msgstr "E-post fungerar med alla leverantörer som erbjuder IMAP och SMTP."

msgid "Security"
msgstr "Säkerhet"

msgid "Also use this account for Notes"
msgstr "Använd även kontot för Anteckningar"

msgid "Checking the account…"
msgstr "Kontrollerar kontot…"

msgid "Cancel"
msgstr "Avbryt"

msgid "“{address}” is not a mail address"
msgstr "”{address}” är ingen e-postadress"

msgid "the message has no recipients"
msgstr "meddelandet har inga mottagare"
