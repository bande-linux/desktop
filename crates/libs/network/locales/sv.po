msgid "NetworkManager has no device called {interface}"
msgstr "NetworkManager har ingen enhet som heter {interface}"

msgid "NetworkManager still leaves {interface} alone"
msgstr "NetworkManager låter fortfarande {interface} vara"

msgid "/etc/network/interfaces has no stanza for it"
msgstr "/etc/network/interfaces har inget avsnitt för den"

msgid "{file} continues lines with a backslash"
msgstr "{file} fortsätter rader med ett omvänt snedstreck"

msgid "{file} maps interfaces with a mapping stanza"
msgstr "{file} mappar gränssnitt med ett mapping-avsnitt"

msgid "the configuration reads “{source}” from outside /etc/network/interfaces.d"
msgstr "konfigurationen läser ”{source}” utanför /etc/network/interfaces.d"

msgid "another stanza in {file} uses it: “{line}”"
msgstr "ett annat avsnitt i {file} använder den: ”{line}”"

msgid "it has more than one “{family}” stanza"
msgstr "den har fler än ett ”{family}”-avsnitt"

msgid "NetworkManager has no equivalent of the “{method}” method"
msgstr "NetworkManager har ingen motsvarighet till metoden ”{method}”"

msgid "NetworkManager has no equivalent of the “{option}” option"
msgstr "NetworkManager har ingen motsvarighet till alternativet ”{option}”"

msgid "the value of “{option}” is not one Settings understands"
msgstr "värdet för ”{option}” är inte ett som Inställningar förstår"

msgid "its stanza names no Wi-Fi network (wpa-ssid)"
msgstr "dess avsnitt anger inget Wi-Fi-nätverk (wpa-ssid)"

msgid "{service} also sets up network interfaces on this computer"
msgstr "{service} konfigurerar också nätverksgränssnitt på den här datorn"

msgid "NetworkManager did not answer ({error})"
msgstr "NetworkManager svarade inte ({error})"

msgid "this computer has no Wi-Fi device"
msgstr "den här datorn har ingen Wi-Fi-enhet"

msgid "the network needs a password"
msgstr "nätverket kräver ett lösenord"

msgid "the network needs a user name and a password or certificate"
msgstr "nätverket kräver ett användarnamn och ett lösenord eller certifikat"

msgid "None"
msgstr "Ingen"

msgid "WPA2 Personal"
msgstr "WPA2 Personal"

msgid "WPA3 Personal"
msgstr "WPA3 Personal"

msgid "WPA Enterprise"
msgstr "WPA Enterprise"

msgid "WEP"
msgstr "WEP"

msgid "joined"
msgstr "ansluten"

msgid "the password is not correct"
msgstr "lösenordet är fel"

msgid "the connection was turned off"
msgstr "anslutningen stängdes av"

msgid "the Wi-Fi device disconnected"
msgstr "Wi-Fi-enheten kopplades från"

msgid "a network service stopped or did not start"
msgstr "en nätverkstjänst stannade eller startade inte"

msgid "the network gave no usable address"
msgstr "nätverket gav ingen användbar adress"

msgid "the network did not answer in time"
msgstr "nätverket svarade inte i tid"

msgid "the saved network was removed"
msgstr "det sparade nätverket togs bort"

msgid "a connection it depends on failed"
msgstr "en anslutning som den är beroende av misslyckades"

msgid "the Wi-Fi device went away"
msgstr "Wi-Fi-enheten försvann"

msgid "the connection failed"
msgstr "anslutningen misslyckades"
