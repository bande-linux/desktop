#!/bin/bash
# The installed settings service answers on a private bus and the installed compositor serves
# Wayland clients headless.
set -euo pipefail
[ -n "${BANDE_TEST_ROOT:-}" ] || exec ci/hermetic.sh --installed-services "$0"
mkdir -p "$XDG_CONFIG_HOME/bande"
echo 'bar { edge "top"; }' > "$XDG_CONFIG_HOME/bande/config.kdl"
/usr/bin/bande-config &
daemon=$!
for _ in $(seq 50); do
    reply=$(dbus-send --session --print-reply --dest=org.bande.Config /org/bande/Config \
        org.freedesktop.DBus.Properties.Get string:org.bande.Config string:BarEdge 2>/dev/null) &&
        break
    sleep 0.1
done
kill "$daemon"
echo "$reply"
grep -q 'string "top"' <<< "$reply"
status=0
timeout 10 bande-compositor --headless > "$TMPDIR/stdout" || status=$?
cat "$TMPDIR/stdout"
[ "$status" = 124 ]
grep -q '^WAYLAND_DISPLAY=wayland-' "$TMPDIR/stdout"
