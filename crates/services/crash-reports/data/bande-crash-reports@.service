[Unit]
Description=Bande crash reports
Documentation=https://github.com/bande-linux/desktop/blob/main/docs/architecture/session.md
After=systemd-journald.socket systemd-pstore.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/bande-crash-reports
StateDirectory=bande/crash-reports
StateDirectoryMode=0755
Nice=10
IOSchedulingClass=idle
MemoryMax=256M
TimeoutStartSec=2min
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
IPAddressDeny=any
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=tmpfs
BindReadOnlyPaths=-/run/user
ReadWritePaths=-/var/lib/bande/reports
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
DefaultInstance=boot
WantedBy=multi-user.target
