#!/bin/bash
# bande-desktop alone, without recommends, brings a login window and sound and no X server or
# Plymouth; the Bande login window is the display manager through its own PAM service, each
# person's folder for it is written by that person and read by it alone, its units hold without
# Plymouth, and purging it hands the display to greetd.
set -euo pipefail
for package in bande-greeter greetd pipewire wireplumber; do
    [ "$(dpkg-query -W -f '${db:Status-Status}' "$package")" = installed ] || { echo "$package is missing"; exit 1; }
done

x11=$(dpkg-query -W -f '${db:Status-Status} ${Package}\n' | awk '$1 == "installed" { print $2 }' |
    grep -E '^(xserver-|xwayland$|xorg$|x11-session-utils$|xinit$)' || true)
[ -z "$x11" ] || { echo "installed: $x11"; exit 1; }
[ "$(dpkg-query -W -f '${db:Status-Status}' plymouth 2> /dev/null)" != installed ] || { echo "plymouth is installed"; exit 1; }
verified=$(systemd-analyze verify --man=no bande-greeter.service bande-greeter-splash.path \
    bande-greeter-splash.service bande-console-fallback.service 2>&1)
[ -z "$verified" ] || { echo "$verified"; exit 1; }
[ "$(stat -c '%a %U %G' /run/bande-greeter)" = "755 _greetd _greetd" ]

greetd_config=/usr/share/bande-greeter/greetd-config.toml
grep -qx "ExecStart=/usr/sbin/greetd --config $greetd_config" /usr/lib/systemd/system/bande-greeter.service
test -x "$(sed -n 's/^command = "\([^ "]*\).*/\1/p' "$greetd_config")"
display_manager() {
    grep -qx "$1" /etc/X11/default-display-manager
    [ "$(basename "$(readlink /etc/systemd/system/display-manager.service)")" = "$(basename "$1").service" ]
}
display_manager /usr/bin/bande-greeter
test ! -e /usr/lib/systemd/system/greetd.service.d
grep -q agreety /etc/greetd/config.toml
service=$(sed -n 's/^service = "\(.*\)"/\1/p' "$greetd_config")
grep -q pam_loginuid "$(ls /etc/pam.d/"$service" /usr/lib/pam.d/"$service" 2>/dev/null | head -n 1)"
share=/var/lib/bande-greeter/users
[ "$(stat -c '%a %U %G' "$share")" = "755 root root" ]
unit=/usr/lib/systemd/system/bande-greeter-share@.service
grep -qx 'StateDirectory=bande-greeter/users/%i' "$unit"
grep -qx 'Wants=bande-greeter-share@%i.service' /usr/lib/systemd/system/user@.service.d/bande-greeter.conf
useradd --create-home ada
useradd --create-home alan
folder="$share/$(id -u ada)"
if [ -d /run/systemd/system ]; then
    systemctl start "bande-greeter-share@$(id -u ada).service"
else
    install -d -o ada -g "$(sed -n 's/^Group=//p' "$unit")" -m "$(sed -n 's/^StateDirectoryMode=//p' "$unit")" "$folder"
fi
[ "$(stat -c '%a %U %G' "$folder")" = "2750 ada _greetd" ]
runuser -u ada -- sh -c "umask 027; echo picture > $folder/picture"
[ "$(runuser -u _greetd -- cat "$folder/picture")" = picture ]
refused() {
    if "$@" > /dev/null 2>&1; then
        echo "allowed: $*"
        exit 1
    fi
}
refused runuser -u alan -- cat "$folder/picture"
refused runuser -u alan -- ls "$folder"
refused runuser -u alan -- touch "$folder/failed"
refused runuser -u alan -- mkdir "$share/$(id -u alan)"
test -e "$folder/picture"
DEBIAN_FRONTEND=noninteractive dpkg --purge bande-greeter < /dev/null
display_manager /usr/sbin/greetd
test ! -e "$share"
echo "bande-desktop brings a login window and sound"
