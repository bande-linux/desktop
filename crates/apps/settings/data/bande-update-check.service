[Unit]
Description=Check for software updates and tell the user when some are available
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-run --user --quiet --collect --slice=background.slice --nice=10 --property=IOSchedulingClass=idle --property=PartOf=graphical-session.target --property=After=graphical-session.target /usr/bin/bande-settings --check-updates
