#!/bin/sh
set -e

. /usr/share/debconf/confmodule

chosen_file=/etc/X11/default-display-manager
alias_link=/etc/systemd/system/display-manager.service

chosen_daemon() {
	grep -v '^[[:space:]]*#' $chosen_file 2> /dev/null | head -n 1
}

if [ "$1" = configure ]; then
	db_get shared/default-x-display-manager
	chosen=$RET
	if [ -n "$chosen" ] && [ "$chosen" != "$(basename "$(chosen_daemon)")" ] && db_get "$chosen/daemon_name"; then
		mkdir -p "$(dirname $chosen_file)"
		echo "$RET" > $chosen_file
	fi
	daemon=$(chosen_daemon)
	if [ -n "$daemon" ] && [ -d "$(dirname $alias_link)" ]; then
		unit=/usr/lib/systemd/system/$(basename "$daemon").service
		if [ "$(readlink $alias_link)" = /dev/null ]; then
			echo "display-manager.service is masked: leaving it so" >&2
		elif [ -e "$unit" ]; then
			ln -sf "$unit" $alias_link
		fi
	fi
fi

db_stop

#DEBHELPER#

signed_in_through_greetd() {
	loginctl list-sessions --no-legend | while read -r session _; do
		if [ "$(loginctl show-session --property Class --value "$session")" = user ] &&
			[ "$(loginctl show-session --property Service --value "$session")" = bande-greeter ]; then
			echo "$session"
		fi
	done
}

if [ "$1" = configure ] && [ -n "$2" ] && [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
	systemctl --system daemon-reload
	for folder in /var/lib/bande-greeter/users/*; do
		if [ -d "$folder" ] && [ "$(stat -c %G "$folder")" != _bande-greeter ]; then
			systemctl start "bande-greeter-share@$(basename "$folder").service" || true
		fi
	done
	main=$(systemctl show --property MainPID --value bande-greeter.service)
	if [ "${main:-0}" -gt 0 ] && [ "$(cat "/proc/$main/comm" 2> /dev/null)" = greetd ] &&
		[ -z "$(signed_in_through_greetd)" ]; then
		systemctl restart bande-greeter.service || true
	fi
fi
