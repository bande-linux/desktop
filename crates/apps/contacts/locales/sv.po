msgstr "Logga in"

msgid "Enter your address, such as jane@example.org."
msgstr "Ange din adress, till exempel anna@exempel.se."

msgid "Looking up the server…"
msgstr "Slår upp servern…"

msgid "Enter your password."
msgstr "Ange ditt lösenord."

msgid "Enter the address of the server."
msgstr "Ange serverns adress."

msgid "Enter your user name."
msgstr "Ange ditt användarnamn."

msgid "Signing in…"
msgstr "Loggar in…"

msgid "Contacts found a CardDAV server for {domain}. Check that it belongs to your provider, then sign in."
msgstr "Kontakter hittade en CardDAV-server för {domain}. Kontrollera att den tillhör din leverantör och logga sedan in."

msgid "Contacts found no CardDAV server for {domain}. Enter the server address your provider gives."
msgstr "Kontakter hittade ingen CardDAV-server för {domain}. Ange serveradressen som din leverantör anger."

