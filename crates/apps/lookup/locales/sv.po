msgid "“{name}” is not a dictionary Dictionary can add. Use a StarDict (.ifo) or dictd (.index) dictionary, a tarball of one, or a dict:// address."
msgstr "”{name}” är inte en ordbok som Ordbok kan lägga till. Använd en ordbok i StarDict- (.ifo) eller dictd-format (.index), ett tar-arkiv med en sådan eller en dict://-adress."

msgid "“{name}” could not be added: {detail}."
msgstr "”{name}” kunde inte läggas till: {detail}."

msgid "Dictionary"
msgstr "Ordbok"

msgid "Dictionary Settings"
msgstr "Inställningar för Ordbok"

msgid "More"
msgstr "Mer"

msgid "No sources are turned on. Choose them in Dictionary Settings."
msgstr "Inga källor är påslagna. Välj dem i inställningarna för Ordbok."

msgid "noun"
msgstr "substantiv"

msgid "verb"
msgstr "verb"

msgid "adjective"
msgstr "adjektiv"

msgid "adverb"
msgstr "adverb"

msgid "Not listed. Last part only: {first} + {ending}"
msgstr "Finns inte med. Bara sista delen: {first} + {ending}"

msgid "Form of {word}"
msgstr "Form av {word}"

msgid "No entries for “{word}”."
msgstr "Inget hittades för ”{word}”."

msgid "All languages"
msgstr "Alla språk"

msgid "{languages}. Online: every word you look up is sent to {name}."
msgstr "{languages}. På nätet: varje ord du slår upp skickas till {name}."

msgid "{languages}. Added by you."
msgstr "{languages}. Tillagd av dig."

msgid "Look Up and Dictionary show results from the sources turned on here, in this order."
msgstr "Slå upp och Ordbok visar resultat från källorna som är påslagna här, i den här ordningen."

msgid "Move Up"
msgstr "Flytta upp"

msgid "Move Down"
msgstr "Flytta ned"

msgid "Remove"
msgstr "Ta bort"

msgid "Add Dictionary…"
msgstr "Lägg till ordbok…"

msgid "dict://dict.org/wn"
msgstr "dict://dict.org/wn"

msgid "Add Server"
msgstr "Lägg till server"

msgid "Add a StarDict or dictd dictionary file, or drop one here. Or add a DICT server (online, unencrypted):"
msgstr "Lägg till en ordbok i StarDict- eller dictd-format, eller släpp en här. Eller lägg till en DICT-server (på nätet, okrypterad):"

msgid "Adding…"
msgstr "Lägger till…"

msgid "Dictionaries"
msgstr "Ordböcker"

msgid "Added “{name}”."
msgstr "”{name}” har lagts till."

