#!/bin/sh
set -e
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -z "$DPKG_ROOT" ] ; then
		if deb-systemd-helper --quiet --user was-enabled bande-backup-alerts.service ; then
			deb-systemd-helper --user enable bande-backup-alerts.service >/dev/null || true
		else
			deb-systemd-helper --user update-state bande-backup-alerts.service >/dev/null || true
		fi
	fi
fi
if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
	systemctl --system daemon-reload >/dev/null || true
	if [ -e /var/lib/bande-backup/state.json ]; then
		systemctl try-restart bande-backup.service >/dev/null || true
	fi
fi
