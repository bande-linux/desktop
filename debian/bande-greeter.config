#!/bin/sh
set -e

. /usr/share/debconf/confmodule

question=shared/default-x-display-manager
chosen_file=/etc/X11/default-display-manager

db_metaget $question owners
owners=$RET
db_metaget $question choices
if [ "$owners" != "$RET" ]; then
	db_subst $question choices "$owners"
	db_fset $question seen false
fi

if [ -s $chosen_file ]; then
	db_set $question "$(basename "$(grep -v '^[[:space:]]*#' $chosen_file | head -n 1)")"
else
	db_fget $question seen
	if [ "$RET" != true ]; then
		db_set $question bande-greeter
	fi
fi

db_input high $question || true
db_go || true
