# Open Terminal and Files, then switch between them with Super+Tab.
note "Open Terminal"
key super+space
wait 600ms
type "terminal"
wait 500ms
key enter
wait-for-window "org.bande.Terminal"
wait 1s
note "Open Files"
key super+space
wait 600ms
type "files"
wait 500ms
key enter
wait-for-window "org.bande.Files"
wait 1200ms
shot "two apps open, Files in front"
note "Super+Tab brings Terminal to the front"
key super+tab
wait 1200ms
shot "terminal in front"
note "Super+Tab again goes back to Files"
key super+tab
wait 1200ms
shot "files in front again"
note "Typing goes to the app in front"
key super+tab
wait 800ms
type "echo switched\n"
wait 1200ms
shot "typed into terminal after switching"
